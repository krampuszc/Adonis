					<ProtectedString name="Source"><![CDATA[
client = nil
cPcall = nil
Pcall = nil
Routine = nil
service = nil
gTable = nil

--// All global vars will be wiped/replaced except script
--// All guis are autonamed client.Variables.CodeName..gui.Name
local UserInputService = game:GetService("UserInputService")
return function(data, env)
	if env then
		client, cPcall, Pcall, Routine, service, gTable =
			env.client, env.cPcall, env.Pcall, env.Routine, env.service, data.gTable
	end

	local placeholder = "Hit ';' & type a command then press Execute or hit Enter"
	local gui = script.Parent.Parent
	local frame = gui.Frame
	local playergui = service.PlayerGui
	local textBox = gui.Frame.Command
	local executeButton = gui.Frame.Execute
	local closeButton = gui.Frame.Close
	gui.Parent = playergui
	frame.AnchorPoint = Vector2.new(1, 1)
	frame.Position=UDim2.new(1,260,1,-34)

	task.wait()
	frame:TweenPosition(UDim2.new(1,-24,1,-34),'Out','Elastic',1)
	executeButton.MouseButton1Click:Connect(function()
		local commandText = textBox.Text
		if commandText ~= "" and commandText ~= placeholder then
			client.Remote.Send("ProcessCommand", textBox.Text)
			textBox.Text = placeholder
		end
	end)

	closeButton.MouseButton1Click:Connect(function()
		gui:Destroy()
	end)
	
	UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
		if input.KeyCode == Enum.KeyCode.Semicolon and not gameProcessedEvent then
			if textBox then
				textBox:CaptureFocus()
			end
		end
	end)

	if textBox then
		textBox.FocusLost:Connect(function(enterPressed)
			if enterPressed then
				local commandText = textBox.Text
				if commandText ~= "" and commandText ~= placeholder then
					client.Remote.Send("ProcessCommand", textBox.Text)
					textBox.Text = placeholder
				else
					textBox.Text = placeholder
				end
			end
		end)
	end

	do
		closeButton.AnchorPoint = Vector2.new(1, 0)
		closeButton.Position = UDim2.new(1, -10, 0, 6)

		executeButton.AnchorPoint = Vector2.new(0, 1)
		executeButton.Position = UDim2.new(0, 7, 1, -10)
		executeButton.Size = UDim2.new(1, -13, 0, 26)

		textBox.AnchorPoint = Vector2.new(0, 0)
		textBox.Position = UDim2.new(0, 7, 0, 27)
		textBox.Size = UDim2.new(1, -13, 1, -70)

		local tConstraint = textBox:FindFirstChildWhichIsA("UITextSizeConstraint") or service.New("UITextSizeConstraint")
		tConstraint.MaxTextSize = 30
		tConstraint.Parent = textBox

		local eConstraint = executeButton:FindFirstChildWhichIsA("UITextSizeConstraint") or service.New("UITextSizeConstraint")
		eConstraint.MaxTextSize = 26
		eConstraint.Parent = executeButton
	end

	do -- SHOULD MAKE THIS UIDragDetectors in the future. This is very unreliable.
		local MouseIcons = {
			Horizontal = "rbxassetid://1243146213";
			Vertical = "rbxassetid://1243145985";
			Corner = "rbxassetid://1243145459";
			AltCorner = "rbxassetid://1243145350";
		}

		local MinSize = {220, 120}
		local MaxSize = {math.huge, math.huge}
		local edgeMargin = 8

		local mouse = service.Players.LocalPlayer:GetMouse()
		local dragDetector = frame:FindFirstChildWhichIsA("UIDragDetector")
		local baseIcon = mouse.Icon
		local resizing = nil
		local start = {}
		local connections = {}

		local function iconFor(dir)
			if dir == "TopLeft" or dir == "BottomRight" then
				return MouseIcons.AltCorner
			elseif dir == "TopRight" or dir == "BottomLeft" then
				return MouseIcons.Corner
			elseif dir == "Left" or dir == "Right" then
				return MouseIcons.Horizontal
			else
				return MouseIcons.Vertical
			end
		end

		local function dirAt(mx, my)
			local pos, size = frame.AbsolutePosition, frame.AbsoluteSize
			local left, top = pos.X, pos.Y
			local right, bottom = left + size.X, top + size.Y

			if mx < left - edgeMargin or mx > right + edgeMargin or my < top - edgeMargin or my > bottom + edgeMargin then
				return nil
			end

			local nearLeft = math.abs(mx - left) <= edgeMargin
			local nearRight = math.abs(mx - right) <= edgeMargin
			local nearTop = math.abs(my - top) <= edgeMargin
			local nearBottom = math.abs(my - bottom) <= edgeMargin

			if nearTop and nearLeft then return "TopLeft" end
			if nearTop and nearRight then return "TopRight" end
			if nearBottom and nearLeft then return "BottomLeft" end
			if nearBottom and nearRight then return "BottomRight" end
			if nearLeft then return "Left" end
			if nearRight then return "Right" end
			if nearTop then return "Top" end
			if nearBottom then return "Bottom" end
			return nil
		end

		local function hasLeft(d) return d == "Left" or d == "TopLeft" or d == "BottomLeft" end
		local function hasRight(d) return d == "Right" or d == "TopRight" or d == "BottomRight" end
		local function hasTop(d) return d == "Top" or d == "TopLeft" or d == "TopRight" end
		local function hasBottom(d) return d == "Bottom" or d == "BottomLeft" or d == "BottomRight" end

		local function updateHover(mx, my)
			if resizing then return end
			local dir = dirAt(mx, my)
			if dir then
				mouse.Icon = iconFor(dir)
				if dragDetector then dragDetector.Enabled = false end
			else
				mouse.Icon = baseIcon
				if dragDetector then dragDetector.Enabled = true end
			end
		end

		local function beginResize(mx, my)
			local dir = dirAt(mx, my)
			if not dir then return end
			resizing = dir
			local pos, size = frame.AbsolutePosition, frame.AbsoluteSize
			start = {
				left = pos.X,
				top = pos.Y,
				right = pos.X + size.X,
				bottom = pos.Y + size.Y,
				w = size.X,
				h = size.Y,
				pos = frame.Position,
				anchor = frame.AnchorPoint,
			}
			if dragDetector then dragDetector.Enabled = false end
		end

		local function doResize(mx, my)
			local dir = resizing
			local newW, newH = start.w, start.h

			if hasLeft(dir) then newW = start.right - mx end
			if hasRight(dir) then newW = mx - start.left end
			if hasTop(dir) then newH = start.bottom - my end
			if hasBottom(dir) then newH = my - start.top end

			if newW < MinSize[1] then newW = MinSize[1] end
			if newH < MinSize[2] then newH = MinSize[2] end
			if newW > MaxSize[1] then newW = MaxSize[1] end
			if newH > MaxSize[2] then newH = MaxSize[2] end

			local dW = newW - start.w
			local dH = newH - start.h

			local dPx = 0
			if hasLeft(dir) then
				dPx = -(1 - start.anchor.X) * dW
			elseif hasRight(dir) then
				dPx = start.anchor.X * dW
			end

			local dPy = 0
			if hasTop(dir) then
				dPy = -(1 - start.anchor.Y) * dH
			elseif hasBottom(dir) then
				dPy = start.anchor.Y * dH
			end

			frame.Size = UDim2.fromOffset(newW, newH)
			frame.Position = UDim2.new(start.pos.X.Scale, start.pos.X.Offset + dPx, start.pos.Y.Scale, start.pos.Y.Offset + dPy)
		end

		local function endResize()
			if not resizing then return end
			resizing = nil
			mouse.Icon = baseIcon
			if dragDetector then dragDetector.Enabled = true end
		end

		connections[#connections + 1] = UserInputService.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				beginResize(input.Position.X, input.Position.Y)
			end
		end)

		connections[#connections + 1] = UserInputService.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				if resizing then
					doResize(input.Position.X, input.Position.Y)
				else
					updateHover(input.Position.X, input.Position.Y)
				end
			end
		end)

		connections[#connections + 1] = UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				endResize()
			end
		end)

		gui.Destroying:Connect(function()
			mouse.Icon = baseIcon
			for _, c in ipairs(connections) do
				c:Disconnect()
			end
		end)
	end

	gTable:Ready()
end]]></ProtectedString>
